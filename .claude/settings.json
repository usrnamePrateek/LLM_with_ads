{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.lmarena-env/**)",
      "Read(./data/**)",
      "Read(./**/*.log)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.ipynb_checkpoints/**)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Bash(./run_vllm.sh -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
